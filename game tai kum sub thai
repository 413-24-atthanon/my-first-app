int score = 0;
int question = 1;

string[] questions =
{
    "คำว่า 'รวดเร็ว' มีความหมายใกล้เคียงกับคำใด?\n1. ช้า\n2. ว่องไว\n3. หนัก",
    "คำว่า 'ขยัน' มีความหมายตรงกับข้อใด?\n1. ตั้งใจทำงาน\n2. นอนหลับ\n3. เกียจคร้าน",
    "คำว่า 'เมตตา' หมายถึงอะไร?\n1. ความโกรธ\n2. ความสงสารและปรารถนาดี\n3. ความกลัว",
    "คำว่า 'สามัคคี' หมายถึงอะไร?\n1. การทะเลาะกัน\n2. การร่วมมือกัน\n3. การแข่งขัน",
    "คำว่า 'ซื่อสัตย์' หมายถึงอะไร?\n1. พูดความจริงและไม่โกง\n2. ชอบโกหก\n3. ชอบเอาเปรียบ"
};

int[] answers = { 2, 1, 2, 2, 1 };
private void btnStart_Click(object sender, EventArgs e)
{
    score = 0;
    question = 1;

    MessageBox.Show("เริ่มเกมทายคำศัพท์ภาษาไทย!");

    ShowQuestion();
}
void ShowQuestion()
{
    if (question <= 5)
    {
        MessageBox.Show(questions[question - 1],
                        "คำถามข้อที่ " + question);
    }
}
private void btnAnswer_Click(object sender, EventArgs e)
{
    int answer;

    if (int.TryParse(txtAnswer.Text, out answer))
    {
        if (answer == answers[question - 1])
        {
            score++;
            MessageBox.Show("ตอบถูก! ได้ 1 คะแนน");
        }
        else
        {
            MessageBox.Show("ตอบผิด!");
        }

        question++;
        txtAnswer.Clear();

        if (question <= 5)
        {
            ShowQuestion();
        }
        else
        {
            EndGame();
        }
    }
    else
    {
        MessageBox.Show("กรุณากรอกคำตอบเป็นตัวเลข 1-3");
    }
}
void EndGame()
{
    string result;

    if (score == 5)
    {
        result = "ดีมาก";
    }
    else if (score >= 2)
    {
        result = "ดี";
    }
    else
    {
        result = "ปรับปรุง";
    }

    MessageBox.Show(
        "จบเกม!\n\n" +
        "คุณได้คะแนน " + score + " / 5 คะแนน\n" +
        "ระดับผลการเล่น: " + result,
        "สรุปคะแนน"
    );
}
